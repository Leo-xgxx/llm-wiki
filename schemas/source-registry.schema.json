{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-wiki/source-registry.schema.json",
  "title": "Domain source registry",
  "description": "raw/source-contracts.yaml. Every source_refs entry, evidence.ref, value_domain.source_ref and snapshot.registry_ref in the domain must resolve to a contract id here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contracts"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "notice": {"type": "string"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "summary", "provenance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*$"},
          "kind": {"enum": ["schema-contract", "interface-contract", "implementation-expression", "observed-output", "document-snapshot", "semantic-decision"]},
          "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["origin", "captured_on", "state_at_capture", "trust"],
            "properties": {
              "origin": {"type": "string", "minLength": 1, "pattern": "\\S", "description": "A stable logical pointer to where the evidence came from. In a public repository this is a description, never a private URL or token."},
              "captured_on": {"type": "string", "format": "date"},
              "state_at_capture": {
                "enum": ["live", "archived", "draft", "published", "approved", "unknown"],
                "description": "The lifecycle state of the origin at capture time."
              },
              "trust": {"enum": ["authoritative", "second-hand", "low"]}
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^raw/snapshots/[A-Za-z0-9][A-Za-z0-9._-]*\\.md$",
                "description": "Path to a managed Markdown snapshot directly under raw/snapshots/."
              },
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "grain": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "time_field": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "logical_fields": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "uniqueItems": true
          },
          "status_values": {
            "type": "object",
            "propertyNames": {"pattern": "\\S"},
            "additionalProperties": {
              "type": "array",
              "items": {"type": ["string", "number", "boolean"]},
              "uniqueItems": true
            }
          },
          "amount_unit": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "document-snapshot"}}, "required": ["kind"]},
            "then": {"required": ["artifact"]},
            "else": {"not": {"required": ["artifact"]}}
          }
        ]
      }
    }
  }
}
