{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-wiki/source-registry.schema.json",
  "title": "Domain source registry",
  "description": "raw/source-contracts.yaml. Every source_refs entry, evidence.ref, value_domain.source_ref and snapshot.registry_ref in the domain must resolve to a contract id here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contracts"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "notice": {"type": "string"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "summary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*$"},
          "kind": {"enum": ["schema-contract", "interface-contract", "implementation-expression", "observed-output", "document-snapshot", "semantic-decision"]},
          "summary": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["origin", "captured_on", "state_at_capture"],
            "properties": {
              "origin": {"type": "string", "minLength": 1, "description": "A stable logical pointer to where the evidence came from. In a public repository this is a description, never a private URL or token."},
              "captured_on": {"type": "string", "format": "date"},
              "state_at_capture": {"type": "string", "minLength": 1, "description": "Whether the origin was live, archived, draft, or unknown when captured."},
              "trust": {"enum": ["authoritative", "second-hand", "low"]}
            }
          }
        }
      }
    }
  }
}
